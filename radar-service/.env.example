# Values belong ONLY in Vercel encrypted project env / local ignored .env; never in static pages.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/admin-service-account.json
# Or GOOGLE_CLOUD_PROJECT with workload identity credentials on managed Google Cloud
GOOGLE_CLOUD_PROJECT=digital-card-radar-db
RADAR_FIRESTORE_DATABASE=(default)
RADAR_ALLOWED_ORIGIN=https://digital-card-binder.github.io
RADAR_READ_MAX_STORES=250
# Do not publish a service-account JSON or use the collector project pokemon-dex-40e92.\n# Confirm exact Project ID in Firebase Project settings before setting GOOGLE_CLOUD_PROJECT.\n# RADAR_SERVICE_ACCOUNT_JSON must be stored ONLY in Vercel encrypted environment variables.
