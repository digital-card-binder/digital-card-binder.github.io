{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://digital-card-binder.github.io"
        },
        {
          "key": "Vary",
          "value": "Origin"
        }
      ]
    }
  ]
}
