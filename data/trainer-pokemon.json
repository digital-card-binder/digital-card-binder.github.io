  "rules": {
    "include": [
      "이름이 확인되는 트레이너·주요 인물과 포켓몬이 같은 일러스트 안에 함께 등장",
      "이름을 특정하기 어려운 일반인·NPC·관중도 포켓몬과 장면의 주체로 함께 등장하면 '그 외의 사람들'에 포함"
    ],
    "exclude": [
      "트레이너 얼굴 아이콘·마크·사진·간판만 있는 경우",
      "배경에 점처럼 작게 보이는 군중처럼 사람과 포켓몬의 관계가 장면의 주제가 아닌 경우"
    ]
  },
